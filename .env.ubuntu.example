# Ubuntu/Linux runtime configuration template for HERMESS Discord Orchestrator.
# Copy to the ignored `.env`, replace placeholders, and never commit secrets.

HERMESS_ROOT=/home/OPERATOR/Projects/HERMESS-Discord-Orchestrator
HERMESS_DATA_DIR=/home/OPERATOR/Projects/HERMESS-Discord-Orchestrator/data
HERMESS_LOG_DIR=/home/OPERATOR/Projects/HERMESS-Discord-Orchestrator/logs
HERMESS_PROJECTS_ROOT=/home/OPERATOR/Projects

# Optional machine-local registry. Copy the tracked template to a local path.
WORKSPACE_REGISTRY_PATH=/home/OPERATOR/.config/hermess/project-workspaces.json

HERMESS_CONTROL_TOKEN=
HERMESS_CONTROL_HOST=127.0.0.1
HERMESS_CONTROL_PORT=47831

# Discord values stay local and blank until provisioned.
DISCORD_ORCHESTRATOR_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_MAIN_USER_ID=
DISCORD_MAIN_BOT_ID=
DISCORD_ASUS_BOT_ID=
DISCORD_IDENTITY_CONFIG=/home/OPERATOR/Projects/HERMESS-Discord-Orchestrator/config/discord-identities.json
DISCORD_CODEX_BOT_TOKEN=
DISCORD_CLAUDE_BOT_TOKEN=
DISCORD_OPENCODE_BOT_TOKEN=
DISCORD_COMMANDCODE_BOT_TOKEN=

# Bare names are resolved through PATH on Ubuntu/Linux.
CODEX_CLI=codex
CLAUDE_CODE_CLI=claude
OPENCODE_CLI=opencode
COMMAND_CODE_CLI=commandcode
HERMES_CLI=hermes
HERMES_ASUS_PROFILE=default

DISCOVERY_INTERVAL_MS=300000
SCHEDULER_INTERVAL_MS=3000
WORKER_HEARTBEAT_MS=15000
TASK_STUCK_MS=1800000
MAX_CONTEXT_BYTES=200000
MAX_DISCUSSION_ROUNDS=3
MAX_AUTONOMOUS_RETRIES=3
LOG_LEVEL=info
PERFORMANCE_EARLY_SIGNAL_MIN=5
PERFORMANCE_OBSERVED_MIN=20
