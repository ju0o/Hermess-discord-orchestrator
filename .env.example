# Local Runtime paths. Use paths writable by the account running HERMESS.
HERMESS_ROOT=
HERMESS_DATA_DIR=
HERMESS_LOG_DIR=
HERMESS_PROJECTS_ROOT=

# Optional trusted local control boundary.
HERMESS_CONTROL_TOKEN=
HERMESS_CONTROL_HOST=127.0.0.1
HERMESS_CONTROL_PORT=47831

# Discord bot tokens. Keep real values only in .env.
DISCORD_ORCHESTRATOR_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_MAIN_USER_ID=
DISCORD_MAIN_BOT_ID=
DISCORD_ASUS_BOT_ID=
DISCORD_IDENTITY_CONFIG=
DISCORD_CODEX_BOT_TOKEN=
DISCORD_CLAUDE_BOT_TOKEN=
DISCORD_OPENCODE_BOT_TOKEN=
DISCORD_COMMANDCODE_BOT_TOKEN=

# Supported local Worker CLI executable names or paths.
CODEX_CLI=codex.cmd
CLAUDE_CODE_CLI=claude.cmd
OPENCODE_CLI=opencode.cmd
COMMAND_CODE_CLI=commandcode.cmd

# Optional Hermes CLI control transport.
HERMES_CLI=hermes
HERMES_ASUS_PROFILE=
HERMES_ASUS_MODEL=

# Runtime tuning.
DISCOVERY_INTERVAL_MS=300000
SCHEDULER_INTERVAL_MS=3000
WORKER_HEARTBEAT_MS=15000
TASK_STUCK_MS=1800000
MAX_CONTEXT_BYTES=200000
MAX_DISCUSSION_ROUNDS=3
MAX_AUTONOMOUS_RETRIES=3
LOG_LEVEL=info
PERFORMANCE_EARLY_SIGNAL_MIN=5
PERFORMANCE_OBSERVED_MIN=20
