{
  "name": "hermess-discord-orchestrator",
  "version": "1.0.0",
  "description": "Local Discord orchestration runtime for coordinating approved coding Workers",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "health": "tsx src/cli/health.ts",
    "models:probe": "tsx src/cli/freeModelProbe.ts",
    "manager:observability": "tsx src/cli/managerInferenceObservability.ts",
    "bridge:inbound": "tsx src/cli/inboundTask.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "discord.js": "^14.21.0",
    "dotenv": "^17.2.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
